# Required: Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Required: Neon Auth endpoint for JWT authentication
NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# Allowed CORS origins (comma-separated for multiple)
# Use http://localhost:5173 for local dev, your domain for production
CORS_ORIGIN=http://localhost:8080

# Server port (default: 3001 in dev, 8080 in Docker)
PORT=8080
